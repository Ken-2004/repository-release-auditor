{
  "name": "repository-release-auditor",
  "version": "0.1.0",
  "description": "Local CLI for evidence-based Git repository release-hygiene checks.",
  "bin": {
    "repository-release-auditor": "dist/src/cli.js"
  },
  "files": [
    "dist/src/**/*.js",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "docs/DEPENDENCIES.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ken-2004/repository-release-auditor.git"
  },
  "homepage": "https://github.com/Ken-2004/repository-release-auditor#readme",
  "bugs": {
    "url": "https://github.com/Ken-2004/repository-release-auditor/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/cli.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "node scripts/build-release.mjs",
    "pack:check": "npm pack --dry-run",
    "pack:verify": "node scripts/verify-package.mjs"
  },
  "keywords": ["cli", "git", "repository-hygiene", "release", "audit"],
  "author": "Harsh Prajapati",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2"
  }
}
